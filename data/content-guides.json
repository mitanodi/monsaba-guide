  "dojo": {
    "label": "バッジ道場",
    "principles": [
      { "text": "属性バッジを集めると属性タタのステータスを強化できる。", "source": "https://w.atwiki.jp/monstersurvival/pages/22.html", "sourceType": "publicWiki", "evidence": "explicit", "checkedAt": "2026-08-24" },
      { "text": "バッジ道場は全コンテンツに関わるため、解放後はなるべく進める価値がある。", "source": "https://w.atwiki.jp/monstersurvival/pages/22.html", "sourceType": "publicWiki", "evidence": "explicit", "checkedAt": "2026-08-24" },
      { "text": "特定タタ対策では配置、優先攻撃、孤立、直線配置回避が重要になる。", "source": "https://w.atwiki.jp/monstersurvival/pages/22.html", "sourceType": "publicWiki", "evidence": "explicit", "checkedAt": "2026-08-24" }
