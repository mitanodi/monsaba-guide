{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/attribute/earth/",
      "destination": "/attribute/rock/",
      "permanent": true
    },
    {
      "source": "/events/card-album/",
      "destination": "/events/summer-party/",
      "permanent": true
    },
    {
      "source": "/en/events/card-album/",
      "destination": "/en/events/summer-party/",
      "permanent": true
    },
    {
      "source": "/zh-cn/events/card-album/",
      "destination": "/zh-cn/events/summer-party/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
