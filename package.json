{
  "name": "monsaba-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "check:syntax": "node scripts/check-js-syntax.mjs",
    "validate:data": "node scripts/validate-data-integrity.mjs",
    "validate:site": "node scripts/validate-site-data.mjs",
    "validate:growth": "node scripts/validate-growth.mjs",
    "validate": "npm run check:syntax && npm run validate:data && npm run validate:site && npm run validate:growth && node scripts/generate-sitemap.mjs --check",
    "generate:tata": "node scripts/generate-tata-pages.mjs",
    "generate:beginner": "node scripts/generate-beginner-guide.mjs",
    "generate:updates": "node scripts/generate-update-2026-08-26.mjs",
    "generate:growth": "node scripts/generate-growth-pages.mjs",
    "generate:core": "node scripts/generate-core-pages.mjs",
    "generate:nav": "node scripts/update-shared-navigation.mjs",
    "generate:footer": "node scripts/update-shared-footer.mjs",
    "generate:foundations": "node scripts/update-growth-foundations.mjs",
    "generate:heroes": "node scripts/update-responsive-heroes.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:site": "npm run generate:tata && npm run generate:beginner && npm run generate:core && npm run generate:updates && npm run generate:growth && npm run generate:nav && npm run generate:footer && npm run generate:foundations && npm run generate:heroes && npm run generate:sitemap",
    "smoke:local": "node scripts/smoke-http.mjs",
    "test:friends": "node --test tests/friends.test.mjs",
    "test:official-x": "node --test tests/official-x.test.mjs",
    "test:family-display": "node --test tests/family-display.test.mjs",
    "test": "npm run test:friends && npm run test:official-x && npm run test:family-display"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2"
  }
}
