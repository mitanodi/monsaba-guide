/* Astra experiment — tokens shared by articles, catalog and tools. */
:root{--bg:#f1f4f8;--surface:#fff;--surface2:#f7f9fc;--text:#162840;--muted:#53677f;--line:#d7e0eb;--primary:#215cc5;--primary-dark:#17489e;--link:#1b55ac;--soft-blue:#edf3ff;--max:1280px;--astra-navy:#111f35;--astra-ink:#162840;--astra-accent:#fac570;--astra-green:#116544;--astra-red:#a3323b;--astra-space-1:4px;--astra-space-2:8px;--astra-space-3:12px;--astra-space-4:16px;--astra-space-6:24px;--astra-space-8:32px;--astra-radius:14px;--astra-small-radius:8px;--astra-border:1px solid var(--line);--astra-shadow:0 3px 16px #17294308;--astra-float:0 16px 60px #101d3930;--astra-type-small:12px;--astra-type-body:15px;--astra-type-title:clamp(24px,3vw,36px);--astra-tier-sss:#8a430f;--astra-tier-ss:#873536;--astra-tier-s:#725013;--astra-tier-a:#24579b;--astra-tier-b:#42634a;--astra-tier-hold:#576274;--astra-grass:#286846;--astra-water:#165d94;--astra-fire:#9b3e2e;--astra-thunder:#775214;--astra-rock:#625446}
body[data-astra]{font-family:Inter,"Noto Sans JP","Yu Gothic",Meiryo,system-ui,sans-serif;font-size:15px;line-height:1.7;background:var(--bg);color:var(--text)}
[data-astra] *{min-width:0}html{scroll-padding-top:88px}body[data-astra] :focus-visible{outline:3px solid #c26c14;outline-offset:4px}body[data-astra] a{ text-underline-offset:3px}body[data-astra] button,body[data-astra] input,body[data-astra] select,body[data-astra] textarea{font:inherit}body[data-astra] button,body[data-astra] select{cursor:pointer}body[data-astra] input,body[data-astra] select,body[data-astra] textarea{border:var(--astra-border);border-radius:var(--astra-small-radius);background:#fff;color:var(--text);max-width:100%;padding:10px 12px}body[data-astra] input[type=checkbox]{width:20px;height:20px;accent-color:var(--primary)}
body[data-astra] .wrap{width:min(var(--max),calc(100% - 48px))}body[data-astra] h1,body[data-astra] h2,body[data-astra] h3{letter-spacing:-.025em;color:var(--text)}body[data-astra] h1{font-size:var(--astra-type-title);line-height:1.35}body[data-astra] h2{font-size:24px;line-height:1.4}body[data-astra] h3{line-height:1.5}body[data-astra] :is(.button,.ghost-button,button:not(.formation-cell,.calendar-day button)){min-height:44px;border-radius:var(--astra-small-radius)}body[data-astra] .button{background:var(--primary);color:#fff;border:1px solid var(--primary);box-shadow:none;font-weight:750}body[data-astra] .ghost-button{background:#fff;color:var(--link);border:var(--astra-border);box-shadow:none}body[data-astra] .button:hover{background:var(--primary-dark)}body[data-astra] .ghost-button:hover{background:var(--soft-blue)}
.astra-nav-caption{display:block;padding:20px 14px 9px;color:#aabbd1;font-size:10px;letter-spacing:.12em;font-weight:800}.astra-primary-nav>a{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:8px;min-height:44px;text-decoration:none}.astra-primary-nav>a>span{width:22px;font-size:18px;text-align:center}.astra-eyebrow{color:var(--link);font-size:10px;font-weight:850;letter-spacing:.15em}.astra-section-heading{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:16px}.astra-section-heading h2{margin:4px 0 0}.astra-section-heading>a{font-size:12px;font-weight:800;white-space:nowrap}.astra-trust{color:var(--muted);font-size:12px}
body[data-astra] .site-header{background:#fff;border-bottom:var(--astra-border);z-index:100}body[data-astra] .header-inner{height:72px;gap:20px;width:calc(100% - 40px);max-width:none}body[data-astra] .brand-main{font-size:17px}body[data-astra] .brand-sub{color:#53677f;border-color:#bac8d8}body[data-astra] .global-search-trigger{background:var(--surface2);color:var(--muted);border:var(--astra-border);justify-content:flex-start;padding:0 16px;min-width:160px}body[data-astra] .global-search-trigger kbd{margin-left:auto}body[data-astra] .language-switcher{margin-left:auto}body[data-astra] .language-switcher label{display:none}body[data-astra] .language-switcher select{font-size:12px;max-width:110px}
body[data-astra] .page-hero{padding:24px 0;background:#fff;border-bottom:var(--astra-border)}body[data-astra] .page-hero h1{margin:10px 0}body[data-astra] .page-hero p{max-width:78ch;color:var(--muted);font-size:14px}body[data-astra] .breadcrumbs{margin:0 0 12px;font-size:11px}body[data-astra] .static-section{margin-top:28px;margin-bottom:28px}body[data-astra] .page-h2{border-left:0;padding-left:0}body[data-astra] .page-toc{border:var(--astra-border);border-radius:var(--astra-small-radius);background:#fff;margin-block:20px;padding:10px 16px;font-size:13px;max-width:var(--max)}body[data-astra] .page-toc summary{min-height:32px}body[data-astra] .page-hero .hero-media{max-width:300px}body[data-astra] :is(.guide-hub-card,.intent-grid>a,.tool-panel,.source-note,.overall-card,.card,.info-card,.calendar-now-card,.community-card){border:var(--astra-border);border-radius:var(--astra-radius);box-shadow:var(--astra-shadow);background:#fff}body[data-astra] :is(.guide-hub-card,.tool-panel){padding:20px}body[data-astra] .source-note{padding:20px;color:var(--muted)}body[data-astra] .trust-label,body[data-astra] .source-state{font-size:11px}body[data-astra] .guide-hub-card h3{margin-top:0}body[data-astra] .guide-hub-card p{font-size:14px;color:var(--muted)}body[data-astra] :is(.prose-page,.article-body){max-width:900px;line-height:1.9}body[data-astra] .tier-badge{font-weight:850;border-radius:6px}
/* Home: clear identity, time-sensitive decisions, then the actual catalog. */
body[data-astra] .astra-home-hero{margin:24px auto 0;width:min(var(--max),calc(100% - 48px));border:0;border-radius:20px;background:var(--astra-navy);padding:30px 32px;position:relative;overflow:hidden}body[data-astra] .astra-home-hero>.wrap{width:100%}body[data-astra] .astra-home-hero .hero-layout{grid-template-columns:minmax(0,1fr) 260px;gap:28px;align-items:center}body[data-astra] .astra-home-hero .hero-note{color:#b0c9ef;font-size:11px;margin:0 0 8px}body[data-astra] .astra-home-title{font-size:clamp(28px,3.5vw,44px);line-height:1.35;font-weight:850;letter-spacing:-.04em;color:#fff;margin:0 0 14px;max-width:660px}body[data-astra] .astra-home-hero h1{font-size:13px;line-height:1.65;color:#d8e5fa;letter-spacing:0;font-weight:600}body[data-astra] .astra-home-hero .lead{color:#aebfd6;font-size:13px;max-width:54ch}body[data-astra] .astra-home-hero .hero-media{display:block;max-width:260px;margin:0;aspect-ratio:1;border-radius:50%;overflow:hidden;border:6px solid #ffffff12;background:#d9f2ff}body[data-astra] .astra-home-hero .hero-media img{display:block;width:100%;height:100%;object-fit:cover}body[data-astra] .astra-home-hero .hero-cta{margin-top:20px}body[data-astra] .astra-home-hero .hero-cta .button{background:var(--astra-accent);border-color:var(--astra-accent);color:#332610}body[data-astra] .astra-home-hero .hero-cta .ghost-button{background:#ffffff0a;border-color:#53657e;color:#fff}body[data-astra] .astra-home-hero .site-stats{margin-top:16px;color:#c6d4e6;font-size:11px}body[data-astra] .astra-home-hero .site-stats b{color:#fff}.astra-home-search{display:flex;align-items:center;gap:12px;margin-top:20px;background:#fff;border-radius:9px;padding:13px 16px;color:#53677f!important;text-decoration:none;font-size:13px;max-width:600px}.astra-home-search span:first-child{font-size:22px;color:var(--primary)}.astra-home-search span:last-child{margin-left:auto}
.astra-today{margin-block:28px}.astra-today-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;min-height:115px}.astra-today-grid>a{display:flex;flex-direction:column;justify-content:center;align-items:start;border:var(--astra-border);border-radius:12px;padding:16px 20px;background:#fff;text-decoration:none;color:var(--text)}.astra-today-grid>a:first-child{border-left:4px solid var(--astra-green)}.astra-today-grid b{font-size:17px;margin:5px 0;line-height:1.4}.astra-today-grid span{font-size:11px;font-weight:800;color:var(--muted)}.astra-today-grid small{font-size:11px;color:var(--muted)}.astra-today-grid>a:hover{border-color:var(--primary)}.astra-schedule-source{font-size:10px;color:var(--muted);margin:8px 0 0;text-align:right}
body[data-astra] .astra-catalog{margin-top:32px;margin-bottom:32px;scroll-margin-top:90px}body[data-astra] .astra-catalog .section-head{margin-bottom:16px;align-items:center;flex-wrap:wrap}body[data-astra] .astra-catalog .hero-search-row{margin:0 0 12px;display:flex;align-items:center;background:#fff;padding:14px;border:var(--astra-border);border-radius:12px;gap:12px}body[data-astra] .astra-catalog .hero-search{flex:1;max-width:none;width:auto}body[data-astra] .astra-catalog #search{padding:0;border:0;min-height:40px}body[data-astra] .astra-catalog .sort-box{min-width:145px}body[data-astra] .astra-catalog .filters{padding:12px 0}body[data-astra] .astra-catalog .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:12px}body[data-astra] .catalog-card{overflow:hidden;transition:border-color .15s}body[data-astra] .catalog-card:hover{border-color:var(--primary);transform:none;box-shadow:0 4px 18px #17294310}body[data-astra] .catalog-card .card-image{height:136px;background:linear-gradient(145deg,#f6f9fd,#e7eef7);margin:0;display:grid;place-items:center}body[data-astra] .catalog-card .card-image img{width:112px;height:112px;object-fit:contain}body[data-astra] .catalog-card .card-body{padding:12px}body[data-astra] .catalog-card h3{font-size:14px;margin:8px 0}body[data-astra] .catalog-card .card-top{font-size:10px}body[data-astra] .catalog-card .card-bottom{font-size:10px}.astra-compact-toggle{font-size:11px!important;margin-left:auto}body[data-astra] .astra-catalog.is-compact .card-image{height:72px}body[data-astra] .astra-catalog.is-compact .card-image img{height:64px;width:64px}body[data-astra] .astra-catalog.is-compact .card-bottom{display:none}
.astra-journey{margin-block:32px}.astra-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.astra-steps>a{display:flex;flex-direction:column;background:#fff;border:var(--astra-border);border-radius:12px;padding:20px;color:var(--text);text-decoration:none}.astra-step-number{color:var(--primary);font-size:12px;font-weight:900;letter-spacing:.1em;margin-bottom:16px}.astra-steps b{font-size:16px}.astra-steps small{margin-top:6px;color:var(--muted);font-size:11px}.astra-steps a:hover{border-color:var(--primary)}.astra-home-reference{border-top:var(--astra-border);padding-top:20px;margin-bottom:32px}.astra-home-reference>summary{font-size:17px;font-weight:800;cursor:pointer;padding:14px 0}.astra-home-reference>.wrap,.astra-home-reference>div>.wrap{width:100%}body[data-astra-page="/"] .page-toc,body[data-astra-page="/"] .personal-entry,body[data-astra-page="/"] .returning-user-panel{display:none}
/* Put evidence and the tool before secondary explanation. */
body[data-astra-page="/tata-tier/"] .page-toc{display:none}body[data-astra-page="/tata-tier/"] .tier-page-hero{padding:18px 0}body[data-astra-page="/tata-tier/"] .tier-page-hero p{font-size:12px;max-width:80ch}body[data-astra-page="/tata-tier/"] .tier-page-hero .page-hero-layout{display:block}body[data-astra-page="/tata-tier/"] .tier-page-hero .hero-media{display:none}body[data-astra-page="/tata-tier/"] .tier-chart{margin-top:12px;border:var(--astra-border);border-radius:12px;overflow:hidden}body[data-astra-page="/tata-tier/"] .tier-chart-tata{background:#f5f7fb;border:1px solid #dbe2ec;border-radius:8px;content-visibility:visible;contain-intrinsic-size:none}body[data-astra-page="/tata-tier/"] .tier-chart-tata span{font-size:11px;font-weight:700;color:var(--text)}body[data-astra-page="/tata-tier/"] .tier-chart-members{gap:10px;padding:14px}.astra-tier-explanation{margin-block:14px;border:var(--astra-border);border-radius:10px;padding:12px 16px;background:#fff}.astra-tier-explanation summary{cursor:pointer;font-weight:700;font-size:13px}
body[data-astra] .tata-character-layout{grid-template-columns:200px minmax(0,1fr);gap:32px;align-items:center}body[data-astra] .tata-character-visual{max-width:200px;border-radius:20px;background:var(--surface2);border:var(--astra-border)}body[data-astra] .tata-quick-answers{padding:24px;background:#fff;border:var(--astra-border);border-radius:14px}body[data-astra] .tata-quick-answers h2{font-size:20px;margin-top:22px}body[data-astra] .mode-rating-grid{gap:10px}body[data-astra] .mode-rating-grid>div{border-radius:10px;background:var(--surface2);padding:12px}body[data-astra] .tata-hero-actions{gap:8px}body[data-astra] .tata-stage-index{background:var(--surface2);border:var(--astra-border);border-radius:12px;padding:16px;margin-block:24px}body[data-astra] .tata-stage-index h2{font-size:15px}body[data-astra] .tata-stage-index li a{min-height:44px;display:flex;align-items:center}body[data-astra] .tata-evolution-timeline{gap:12px}body[data-astra] .evo-card{border-radius:12px}
body[data-astra] .astra-compact-hero{padding-block:14px}body[data-astra] .astra-compact-hero h1{font-size:26px}body[data-astra] .astra-compact-hero .family-page-head{align-items:center}body[data-astra-page="/team-builder/"] .formation-shell{--tool-width:1280px;width:min(var(--max),calc(100% - 48px));margin:18px auto;gap:16px}body[data-astra-page="/team-builder/"] .formation-shell>.tool-panel:first-of-type{padding:12px 18px}.astra-mode-toolbar{display:flex;align-items:center;gap:12px}.astra-mode-toolbar>label{display:flex;align-items:center;gap:16px;width:100%;font-size:13px;font-weight:800}.astra-mode-toolbar select{flex:1;max-width:360px}.astra-settings-details{margin-top:8px}.astra-settings-details>summary{font-size:12px;font-weight:700;color:var(--muted);cursor:pointer;min-height:36px;padding:5px 0}.astra-settings-details .section-head h2{font-size:18px}.astra-settings-details .tool-toolbar{margin-top:12px}.astra-settings-details input{min-height:44px}.astra-chip-details{border:var(--astra-border);border-radius:8px;margin-top:14px;padding:10px}.astra-chip-details>summary{font-weight:800;font-size:13px;cursor:pointer}.astra-chip-details:not(:has(#team-chip-settings:not([hidden]))){display:none}body[data-astra] .formation-workspace{grid-template-columns:minmax(0,1fr) minmax(260px,.7fr);gap:18px;align-items:start}body[data-astra] .formation-board-panel{padding:18px}body[data-astra] .formation-board-panel .section-head h2{font-size:20px}body[data-astra] .formation-board-panel .section-head p{font-size:11px;color:var(--muted);margin:4px 0}body[data-astra] .formation-board{max-width:580px;border-radius:12px;padding:8px;background:#e3eaf4;gap:5px;border:1px solid #bacbdf;margin-inline:auto}body[data-astra] .formation-cell{border-radius:7px;border:1px solid #c2d1e2;background:#f7faff;touch-action:manipulation}body[data-astra] .formation-cell:hover{background:#dfebff}body[data-astra] .formation-picker{position:sticky;top:90px;max-height:calc(100dvh - 115px);padding:18px;overflow:auto}body[data-astra] .formation-picker-list{max-height:55dvh}body[data-astra] .formation-player-settings{gap:8px;margin-block:12px}body[data-astra] .formation-player-card{padding:10px}body[data-astra] .formation-primary-actions{margin-block:10px}.astra-community-intro{margin-block:24px;padding:24px;border:var(--astra-border);border-left:4px solid var(--primary);border-radius:12px;background:#fff}.astra-community-intro h2{max-width:28ch;font-size:26px!important;margin:8px 0}.astra-community-intro>p{max-width:70ch;color:var(--muted);font-size:13px}.astra-read-only{font-size:11px!important;background:#f6f0e4;padding:10px 12px;border-radius:6px;color:#71521a!important}.astra-search-help{font-size:13px;padding-block:12px;color:var(--muted)}body[data-astra] .community-empty{background:#f4f7fc;border:1px dashed #b0c4dd;border-radius:12px}body[data-astra] .community-view-tabs{top:72px}
/* Calendar remains one data source; its own page owns the full month. */
body[data-astra] .event-calendar{margin-block:24px}body[data-astra] .calendar-now-grid{gap:12px}body[data-astra] .calendar-now-card{padding:18px}body[data-astra] .calendar-now-card h3{font-size:14px}body[data-astra] .calendar-day{background:#fff;border-color:var(--line)}body[data-astra] .calendar-day.is-today{background:#edf4ff;box-shadow:inset 0 0 0 2px var(--primary)}body[data-astra] .calendar-entry{font-size:10px;padding:6px;border-radius:4px}body[data-astra] .calendar-entry strong{font-size:11px}body[data-astra] .calendar-toolbar{border:var(--astra-border);background:#fff;border-radius:10px;padding:12px}body[data-astra] .calendar-scroll{border-radius:12px}body[data-astra] .calendar-live{color:#116544;background:#dcf4e8}body[data-astra] .calendar-pending{color:#795519;background:#fbefda}
/* Advertisements are distinct, inert, and never fixed. */
